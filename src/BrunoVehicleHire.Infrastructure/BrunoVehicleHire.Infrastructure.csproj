<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- spec-6-1: DatabaseSeeder generates synthetic, but realistic, Vehicles/Customers/Bookings for
         a fresh clone; never a source of real PII (SPEC.md's own logged assumption). -->
    <PackageReference Include="Bogus" Version="35.6.5" />
    <!-- The full implementation package (not just .Abstractions): the AppDbContext runtime
         consumer needs IDataProtector/IDataProtectionProvider's actual implementation. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.12" />
    <!-- .Extensions ships the concrete DataProtectionProvider convenience class (static
         Create(DirectoryInfo) etc.) that AppDbContextFactory's design-time-only construction
         needs; the base package only exposes the DI-builder-based registration path. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Pinned explicitly (not just pulled in transitively via Design, which is PrivateAssets)
         so downstream projects (Api, Integration.Tests) resolve the same Relational version
         Infrastructure.dll was built against. Npgsql's own dependency range floors at 10.0.4,
         which without this pin causes a runtime FileNotFoundException loading Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- spec-4-4: BookingCompletionSweepService is a BackgroundService (AD-17), constructor-injected
         with IServiceScopeFactory/IOptions, pinned to the exact version already resolved
         transitively via the EF Core/DataProtection packages above, so restore never unifies it
         upward on its own. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- BookingCompletionSweepService dispatches CompleteBookingCommand via MediatR's ISender
         directly, pinned to the exact version BrunoVehicleHire.Application already resolves. -->
    <PackageReference Include="MediatR" Version="14.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrunoVehicleHire.Application\BrunoVehicleHire.Application.csproj" />
    <ProjectReference Include="..\BrunoVehicleHire.Domain\BrunoVehicleHire.Domain.csproj" />
  </ItemGroup>

</Project>
