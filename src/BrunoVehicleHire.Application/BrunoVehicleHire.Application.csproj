<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BrunoVehicleHire.Domain\BrunoVehicleHire.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- spec-swagger-examples: surfaces this project's existing XML doc comments (Commands/DTOs) as
         real Swagger descriptions via IncludeXmlComments (Api's Program.cs). NoWarn suppresses
         CS1591 ("missing XML comment for publicly visible type or member") since this project does
         not mandate doc comments on every public member, only surfaces the ones that already exist. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!-- spec-4-2: CreateBookingCommandHandler catches the specific Postgres exclusion-violation
         (DbUpdateException whose InnerException is a Npgsql.PostgresException with SqlState
         "23P01") to translate the database-level overlap backstop into the same 409 shape as the
         application-level check, pinned to the exact versions BrunoVehicleHire.Infrastructure
         already resolves (Microsoft.EntityFrameworkCore defines DbUpdateException;
         Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 resolves Npgsql 10.0.3), so no version gets
         unified upward at restore time. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
